# Disalin ke /srv/easylearn/.env di VPS. Jangan commit berkas .env.
PORT=3210
DATA_DIR=/data
SEED_FILE=/seed/topics.json
# Token rahasia yang sama dengan DATA_TOKEN di Vercel
DATA_TOKEN=
# Alamat aplikasi di Vercel, dipakai untuk tautan di notifikasi
APP_URL=https://easylearnn-seven.vercel.app
# Kunci Web Push, buat sekali dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
