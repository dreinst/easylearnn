# Disalin ke /srv/easylearn/.env di VPS. Jangan commit berkas .env.
PORT=3210
DATA_DIR=/srv/easylearn/data
SEED_FILE=/srv/easylearn/seed/topics.json
# Token rahasia yang sama dengan DATA_TOKEN di Vercel
DATA_TOKEN=
# Alamat aplikasi di Vercel, dipakai untuk tautan di notifikasi
APP_URL=https://easylearnn-seven.vercel.app
# Kunci Web Push, buat sekali dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Chatbot lewat Hermes CLI yang sudah terpasang di VPS (memakai kredensial di ~/.hermes)
HERMES_BIN=/usr/local/bin/hermes
HERMES_MODEL=claude-haiku-4-5
HERMES_PROVIDER=anthropic
HERMES_TOOLSET=clarify
HERMES_TIMEOUT_MS=120000
CHAT_MAX_PER_10MIN=40
