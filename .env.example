# Salin ke .env.local untuk lokal, atau isi di Vercel > Settings > Environment Variables.

# Alamat layanan data di VPS (folder progres + jurnal) dan token rahasianya.
# Token harus sama dengan DATA_TOKEN di /srv/easylearn/.env di VPS.
DATA_API_URL=https://easylearn-api.187.53.129.205.sslip.io
DATA_TOKEN=

# Chatbot: tanpa variabel tambahan, pertanyaan diteruskan ke Hermes di VPS lewat layanan data.
# Opsional: kalau diisi, chatbot memakai API Anthropic langsung (Claude Haiku 4.5) dan tidak lewat Hermes.
ANTHROPIC_API_KEY=
